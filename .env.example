# Mocks / Offline Dev Mode (FASE 8): 'true' = UI sin Supabase ni IA real.
# Por defecto false: producción nunca debe compilar con mocks.
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_AI_API=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Supabase
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=only-server-never-expo
# IA ligera (Groq / OpenAI)
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
AI_PROVIDER=groq
# WhatsApp Ops (Twilio o Meta Cloud API)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
WHATSAPP_FROM=whatsapp:+14155238886
# Mercado Pago (pasarela regional - webhooks)
MERCADOPAGO_ACCESS_TOKEN=TEST-...
MERCADOPAGO_WEBHOOK_SECRET=...
MERCADOPAGO_WEBHOOK_URL=https://api.eventops.app/webhooks/mercadopago
# Sentry (el código lee EXPO_PUBLIC_SENTRY_DSN)
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Invitaciones
INVITE_BASE_URL=https://mi-boda.eventops.app/invitado
